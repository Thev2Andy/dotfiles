{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "display": {
        "separator": " "
    },
    "modules": [
	    {
            "type": "title",
            "format": "{full-user-name} [{#35}{host-name}{#}]",
            "key": "\uf415",
	    "keyColor": "35"
        },
        "separator",
        {
            "type": "os",
            "key": " "
        },
        {
            "type": "kernel",
            "key": " "
        },
        {
            "type": "packages",
	    "format": "{all} packages ({flatpak-all} are flatpaks)",
            "key": " "
        },
        {
            "type": "shell",
            "key": " "
        },
        {
            "type": "terminal",
            "key": " "
        },
        {
            "type": "wm",
            "key": " "
        },
        {
            "type": "uptime",
            "format": "Up {formatted}",
            "key": " "
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "format": "[{player-name}] {title} — {artist}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  "
        },
        "break"
    ]
}
