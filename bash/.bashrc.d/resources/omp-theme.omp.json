{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "fg": "#FFFFFF",
    "user": "#322D8B",
    "folder": "#D18771",
    "git": "#3BCB8B",
    "time": "#528BFF"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:user",
          "foreground": "p:fg",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\uf415 {{ if .UserName }}{{ .UserName }} {{ end }}",
          "type": "session"
        },
        {
          "background": "p:folder",
          "foreground": "p:fg",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "folder"
          },
          "style": "powerline",
          "template": " \uf413 {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "p:git",
          "foreground": "p:fg",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "",
            "fetch_status": false,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ if .UpstreamIcon }}{{ .UpstreamIcon }}{{ else }}\ue725{{ end }} {{ .HEAD }}{{ if gt .StashCount 0 }} ({{ .StashCount }} \uf0c7){{ end }} ",
          "type": "git"
        },
        {
          "background": "p:time",
          "foreground": "p:fg",
          "options": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": " \uf43a {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b0",
          "type": "time"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}