// ╭─────── Modifier Guideline ───────╮
// ├──────────────────────────────────┤
// │ Ctrl     → Workspace-related     │
// │ Shift    → Window/Move related   │
// │ Alt      → Column-related        │
// │ Ctrl+Alt → Monitor-related       │
// ╰──────────────────────────────────╯

binds {
    // ─── Application Launchers ───
    Mod+Q repeat=false { spawn-sh "~/.config/niri/scripts/launch-app.sh terminal"; }
    Mod+E repeat=false { spawn-sh "~/.config/niri/scripts/launch-app.sh files"; }
    Mod+B repeat=false { spawn-sh "~/.config/niri/scripts/launch-app.sh browser"; }
    Mod+Z repeat=false { spawn-sh "~/.config/niri/scripts/launch-app.sh editor"; }

    // ─── Recording Application IPC ───
    Pause repeat=false { spawn-sh "~/.config/niri/scripts/launch-app.sh ipc-instant-replay"; }

    // ─── Shell Binds ───
    Mod+Space repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+V repeat=false { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+M repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center" "system"; }
    Mod+Y repeat=false { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Comma repeat=false { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Period repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher" "/emo "; }
    Mod+Slash repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher" "/"; }
    Mod+N repeat=false { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Shift+Tab repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher" "/win "; }
    XF86Calculator repeat=false { spawn "noctalia" "msg" "panel-toggle" "launcher" "/calc "; }
    Mod+Tab repeat=false { toggle-overview; }

    // ─── Security ───
    Mod+L repeat=false { spawn "loginctl" "lock-session"; }
    Mod+Shift+M repeat=false { quit; }

    // ─── Audio Controls ───
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    
    // ─── Microphone Controls ───
    Shift+XF86AudioRaiseVolume { spawn "noctalia" "msg" "mic-volume-up"; }
    Shift+XF86AudioLowerVolume { spawn "noctalia" "msg" "mic-volume-down"; }
    XF86AudioMicMute repeat=false { spawn "noctalia" "msg" "mic-mute"; }
    Ctrl+Control_R repeat=false { spawn "noctalia" "msg" "mic-mute"; }

    // ─── Media Controls ───
    XF86AudioStop repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioPlay repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext repeat=false allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    // ─── Screenshots ───
    Print repeat=false { screenshot; }
    Ctrl+Print repeat=false { screenshot-screen; }
    Alt+Print repeat=false { screenshot-window; }

    // ─── Brightness Controls ───
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // ─── Workspace Navigation ───
    Mod+Ctrl+Left repeat=false { focus-workspace-up; }
    Mod+Ctrl+WheelScrollUp repeat=false { focus-workspace-up; }
    Mod+Ctrl+Right repeat=false { focus-workspace-down; }
    Mod+Ctrl+WheelScrollDown repeat=false { focus-workspace-down; }

    // ─── Adjacent Workspace Window Movement ───
    Mod+Ctrl+Shift+Left repeat=false { move-window-to-workspace-up; }
    Mod+Ctrl+Shift+Right repeat=false { move-window-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp repeat=false { move-window-to-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown repeat=false { move-window-to-workspace-down; }

    // ─── Window Management ───
    Mod+C repeat=false { close-window; }
    Mod+F repeat=false { spawn-sh "~/.config/niri/scripts/maximize-window-or-column.sh"; }
    Mod+Shift+F repeat=false { fullscreen-window; }
    Mod+W repeat=false { toggle-window-floating; }

    // ─── Column Focus Navigation ───
    Mod+Left repeat=false { focus-column-left; }
    Mod+Right repeat=false { focus-column-right; }
    Mod+WheelScrollUp repeat=false { focus-column-left; }
    Mod+WheelScrollDown repeat=false { focus-column-right; }
    Mod+Up repeat=false { focus-window-up; }
    Mod+Down repeat=false { focus-window-down; }

    // ─── Guideline Fill Column Focus Navigation Binds ───
    Mod+Alt+Left repeat=false { focus-column-left; }
    Mod+Alt+Right repeat=false { focus-column-right; }
    Mod+Alt+WheelScrollUp repeat=false { focus-column-left; }
    Mod+Alt+WheelScrollDown repeat=false { focus-column-right; }
    Mod+Alt+Up repeat=false { focus-window-up; }
    Mod+Alt+Down repeat=false { focus-window-down; }

    // ─── Column Movement ───
    Mod+Alt+Shift+Left repeat=false { move-column-left; }
    Mod+Alt+Shift+Right repeat=false { move-column-right; }

    // ─── Window Movement ───
    Mod+Shift+Left repeat=false { consume-or-expel-window-left; }
    Mod+Shift+Right repeat=false { consume-or-expel-window-right; }
    Mod+Shift+Up repeat=false { move-window-up; }
    Mod+Shift+Down repeat=false { move-window-down; }

    // ─── Monitor Focus Navigation ───
    Mod+Ctrl+Alt+Left repeat=false { focus-monitor-left; }
    Mod+Ctrl+Alt+Right repeat=false { focus-monitor-right; }
    Mod+Ctrl+Alt+Up repeat=false { focus-monitor-up; }
    Mod+Ctrl+Alt+Down repeat=false { focus-monitor-down; }

    // ─── Monitor Window Movement ───
    Mod+Ctrl+Alt+Shift+Left repeat=false { move-window-to-monitor-left; }
    Mod+Ctrl+Alt+Shift+Right repeat=false { move-window-to-monitor-right; }
    Mod+Ctrl+Alt+Shift+Up repeat=false { move-window-to-monitor-up; }
    Mod+Ctrl+Alt+Shift+Down repeat=false { move-window-to-monitor-down; }

    // ─── Direct To Numbered Workspaces ───
    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { focus-workspace 6; }
    Mod+7 repeat=false { focus-workspace 7; }
    Mod+8 repeat=false { focus-workspace 8; }
    Mod+9 repeat=false { focus-workspace 9; }
    Mod+0 repeat=false { focus-workspace 10; }

    // ─── Direct To Numbered Workspace Window Movement ───
    Mod+Shift+1 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 1"; }
    Mod+Shift+2 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 2"; }
    Mod+Shift+3 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 3"; }
    Mod+Shift+4 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 4"; }
    Mod+Shift+5 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 5"; }
    Mod+Shift+6 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 6"; }
    Mod+Shift+7 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 7"; }
    Mod+Shift+8 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 8"; }
    Mod+Shift+9 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 9"; }
    Mod+Shift+0 repeat=false { spawn-sh "~/.config/niri/scripts/move-window-to-workspace-silent.sh 10"; }

    // ─── Manual Sizing ───
    Mod+Minus { set-window-width "-10%"; }
    Mod+Equal { set-window-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // ─── Dynamic Casting Controls ───
    Mod+P repeat=false { set-dynamic-cast-window; }
    Mod+Ctrl+Alt+P repeat=false { set-dynamic-cast-monitor; }
    Mod+Shift+P repeat=false { clear-dynamic-cast-target; }
}